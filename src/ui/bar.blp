using Gtk 4.0;
using Astal 4.0;

template $Bar: Astal.Window {
    CenterBox {
        start-widget: Box left {
            spacing: 10;

            $Workspaces {}

            Separator {}
            
            $ActiveClient {}
        };

        center-widget: Box center {
            $Music {}
        };
        
        end-widget: Box right {
            spacing: 10;
            Label clock {}
            $AudioIcon {}
            $NetworkIcon {}
            $BluetoothIcon {}
        };
    }
}
